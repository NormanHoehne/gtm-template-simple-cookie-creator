___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setCookie = require('setCookie');
const log = require('logToConsole');
const makeNumber = require('makeNumber');
const makeString = require('makeString');

const name = makeString(data.name);
const value = data.value;

// Skip undefined logic
if (data.skipUndefined) {
  if (value === undefined || value === 'undefined' || value === null || value === 'null' || value === '') {
    log('Cookie value undefined/empty. Skipping.');
    return data.gtmOnSuccess();
  }
}

const finalValue = makeString(value);

const options = {
  domain: data.domain || 'auto',
  path: data.path || '/',
  secure: data.secure === true,
  samesite: data.samesite || 'lax'
};

if (data.expirationMode !== 'session') {
  let duration = data.expirationValue;
  // Convert input to number safely
  if (duration) {
      duration = makeNumber(duration);
  }
  
  if (duration) {
    let multiplier = 1;
    if (data.expirationMode === 'days') multiplier = 86400;
    else if (data.expirationMode === 'hours') multiplier = 3600;
    else if (data.expirationMode === 'minutes') multiplier = 60;
    // seconds = 1 default
    
    options['max-age'] = duration * multiplier;
  }
}

setCookie(name, finalValue, options);
data.gtmOnSuccess();


