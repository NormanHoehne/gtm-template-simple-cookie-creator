___TESTS___

scenarios:
- name: Standard Cookie Test
  code: |-
    // Mock the setCookie API to verify it receives the right data
    mock('setCookie', (name, value, options) => {
      assertThat(name).isEqualTo('affiliate_code');
      assertThat(value).isEqualTo('12345');
      assertThat(options['max-age']).isEqualTo(604800); // 7 days * 86400 seconds
      assertThat(options.secure).isEqualTo(true);
      assertThat(options.samesite).isEqualTo('lax');
    });

    // Run the template code with our mock data
    runCode(mockDataStandard);
- name: Session Cookie Test
  code: |-
    mock('setCookie', (name, value, options) => {
      // Session cookies must NOT have max-age set
      assertThat(options['max-age']).isEqualTo(undefined);
      assertThat(options.samesite).isEqualTo('strict');
    });

    runCode(mockDataSession);
- name: Skip undefined Test
  code: |-
    // We start by assuming the cookie has NOT been set yet.
    let cookieSet = false;

    // We replace the real 'setCookie' function with our fake one.
    // If the tag code reaches this point and tries to run 'setCookie',
    // our fake function runs and flips the switch to TRUE.
    mock('setCookie', (name, value, options) => {
      cookieSet = true;
    });

    runCode(mockDataSkip);

    // Assert that the flag is still false (cookie was NEVER set)
    assertThat(cookieSet).isEqualTo(false);
setup: |-
  const mockDataStandard = {
    name: 'affiliate_code',
    value: '12345',
    expirationMode: 'days',
    expirationValue: 7,
    path: '/',
    domain: 'example.com',
    secure: true,
    samesite: 'lax'
  };

  const mockDataSession = {
    name: 'session_cookie',
    value: 'abc',
    expirationMode: 'session',
    path: '/',
    samesite: 'strict'
  };

  const mockDataSkip = {
    name: 'skip_me',
    value: undefined,
    skipUndefined: true
  };


